# Server
HOST=127.0.0.1
PORT=3002
DATA_DIR=./data
COOKIE_SECURE=false
SESSION_DAYS=7
# Set to a hop count (for example 1) only behind a trusted reverse proxy.
TRUST_PROXY=false

# ElevenLabs (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_NAME=Victor

# Zadarma (server-side only)
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_SIP_NUMBER=
# Keep false until live calls are explicitly wanted.
ALLOW_LIVE_CALLS=false

# Optional overrides
# ENV_FILE=.env
# DB_FILE=./data/victor.db
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ZADARMA_BASE_URL=https://api.zadarma.com
