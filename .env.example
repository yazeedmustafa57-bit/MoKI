# Server
HOST=127.0.0.1
PORT=3002
DATA_DIR=./data
COOKIE_SECURE=false
SESSION_DAYS=7
# Set to a hop count (for example 1) only behind a trusted reverse proxy.
TRUST_PROXY=false

# Public production fallback / preview
PREVIEW_MODE=true
# Keep false until live calls are explicitly wanted.
ALLOW_LIVE_CALLS=false

# Owner bootstrap for an empty database. Never commit real values.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD_HASH=
OWNER_BOOTSTRAP_NAME=Owner

# Encrypted integration credentials
# Prefer SECRETS_KEY_FILE on a persistent volume; SECRETS_KEY is an alternative.
SECRETS_KEY=
SECRETS_KEY_FILE=./data/secrets.key

# Backups. BACKUP_DIR must be a separate/off-site volume in production.
BACKUP_DIR=./data/backups
BACKUP_KEEP=14

# ElevenLabs (server-side only)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_NAME=Victor
ELEVENLABS_PHONE_NUMBER_ID=

# Zadarma (server-side only)
ZADARMA_KEY=
ZADARMA_SECRET=
ZADARMA_SIP_NUMBER=

# Optional overrides
# ENV_FILE=.env
# DB_FILE=./data/victor.db
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ZADARMA_BASE_URL=https://api.zadarma.com
